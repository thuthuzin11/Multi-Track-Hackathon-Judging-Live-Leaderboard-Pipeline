# Copy this file to .env and adjust if your local Postgres/Redis differ.


DATABASE_URL=postgresql://postgres:thu%40nao1124@localhost:5432/hackathon
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Judge login tokens are signed with this. Set it to a long random string
# in production -- anyone who has it can forge a judge login.
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_MINUTES=720

# Comma-separated list of frontend origins allowed to call this API, e.g.
#   ALLOWED_ORIGINS=https://myapp.vercel.app,https://myapp.com
# "*" (default) allows any origin -- fine for local dev / a class demo.
ALLOWED_ORIGINS=*
